          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum(rate(redis_commands_latencies_usec_bucket{cmd=\"evalsha\"}[30s])) by (le)) / 1000",
          "legendFormat": "p95"
        }
      ]
    },
