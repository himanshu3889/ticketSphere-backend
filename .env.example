# App
APP_NAME=ticketsphere
APP_LOG_LEVEL=info
APP_ENV=dev

# Gateway PORT
GATEWAY_PORT=7777

# Secrets
JWT_SECRET=ticketsphere
JWT_ISSUER=ticketsphere
JWT_AUDIENCE=ticketsphere
GATEWAY_SECRET=ticketsphere-secret

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_DB=ticketsphere
POSTGRES_USER=ticketsphere
POSTGRES_PASSWORD=ticketsphere
POSTGRES_PORT=5432

# MongoDB
MONGODB_HOST=localhost
MONGODB_ROOT_PASSWORD=ticketsphere
MONGODB_DATABASE=ticketsphere
MONGODB_USERNAME=ticketsphere
MONGODB_PASSWORD=ticketsphere
MONGODB_PORT=27017

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=ticketsphere
REDIS_DB=0

# Monitoring & UI
PROMETHEUS_USER=ticketsphere
PROMETHEUS_PASSWORD=ticketsphere
PROMETHEUS_PORT=9090
GRAFANA_ADMIN_PASSWORD=ticketsphere
GRAFANA_PORT=3000

LOKI_HOST=localhost
LOKI_PORT=3100

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Exporter Ports
REDIS_EXPORTER_PORT=9121
POSTGRES_EXPORTER_PORT=9187
MONGODB_EXPORTER_PORT=9216

# Rabbitmq
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=ticketsphere
RABBITMQ_PASSWORD=ticketsphere



# Servers
INVENTORY_API_TARGET=http://192.168.1.12:7010
BOOKING_API_TARGET=http://192.168.1.12:7020
PAYMENT_API_TARGET=http://192.168.1.12:7030


# Linux
# COMPOSE_FILE="docker-compose.yml:docker-compose.monitoring.yml:docker-compose.gateway.yml"
# Windows
COMPOSE_FILE=docker-compose.yml;docker-compose.monitoring.yml;docker-compose.gateway.yml;docker-compose.exporter.yml;docker-compose.rmq.yml